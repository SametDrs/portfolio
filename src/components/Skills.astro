---
import { dictionaries, type Lang } from "../i18n";
import { before, added } from "../data/skills";

interface Props {
  lang: Lang;
}

const t = dictionaries[Astro.props.lang].skills;
---

<section id="skills">
  <div class="wrap">
    <div class="head reveal">
      <div class="eyebrow">{t.eyebrow}</div>
      <h2 class="display sm">{t.pre} <span class="hl">{t.hl}</span> {t.post}</h2>
    </div>
    <div class="skill-grid">
      <div class="skill-card reveal">
        <h3>{t.before.title}</h3>
        <p>{t.before.text}</p>
        <ul class="chips">
          {before.map((s) => <li class="chip">{s}</li>)}
        </ul>
      </div>
      <div class="skill-card after reveal" style="--d:.12s">
        <h3>{t.after.title}</h3>
        <p>{t.after.text}</p>
        <ul class="chips">
          {before.map((s) => <li class="chip">{s}</li>)}
          {added.map((s) => <li class="chip new">{s}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
