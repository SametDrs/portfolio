---
import { dictionaries, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const t = dictionaries[Astro.props.lang].hero;
---

<header class="hero wrap" id="top">
  {t.tags.map((tag) => <div class="tag">{tag}</div>)}

  <div class="eyebrow">{t.eyebrow}</div>
  <h1 class="display">{t.titleA} <span class="hl">{t.hl1}</span><br />{t.titleB} <span class="hl blue">{t.hl2}</span></h1>
  <p>{t.text}</p>
  <div class="cta">
    <a class="btn" href="#projects">{t.ctaProjects}</a>
    <a class="btn ghost" href="#contact">{t.ctaContact}</a>
  </div>
</header>
