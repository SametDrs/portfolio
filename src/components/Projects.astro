---
import { dictionaries, type Lang } from "../i18n";
import { projects } from "../data/projects";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dictionaries[lang].projects;
---

<section class="projects dark" id="projects">
  <div class="wrap">
    <div class="head reveal">
      <div class="eyebrow">{t.eyebrow}</div>
      <h2 class="display sm">{t.pre} <span class="hl">{t.hl}</span> {t.post}</h2>
    </div>
    <div class="grid">
      {projects.map((p, i) => (
        <a
          class:list={["card", "reveal", p.variant]}
          style={`--d:${(i % 3) * 0.1}s`}
          href={p.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="badge">{p.badge}</span>
          <h3>{p.name}</h3>
          <p>{p.desc[lang]}</p>
          <span class="more">{p.external ? "harman.alesta.dev →" : t.github}</span>
        </a>
      ))}
    </div>
  </div>
</section>
