---
import { dictionaries, type Lang } from "../i18n";
import { projects as all, type ProjectGroup } from "../data/projects";

interface Props {
  lang: Lang;
  group?: ProjectGroup;
}

const { lang, group = "open" } = Astro.props;
const t = dictionaries[lang].projects;
const s = t.sections[group];
const projects = all.filter((p) => p.group === group);
---

<section class="projects dark" id={group === "open" ? "projects" : `projects-${group}`}>
  <div class="wrap">
    <div class="head reveal">
      <div class="eyebrow">{s.eyebrow}</div>
      <h2 class="display sm">{s.pre} <span class="hl">{s.hl}</span> {s.post}</h2>
    </div>
    <div class="grid">
      {projects.map((p, i) => {
        const cls = ["card", "reveal", p.variant];
        const delay = `--d:${(i % 3) * 0.1}s`;
        // Tech names keep lang="en" so Turkish uppercasing does not turn "Tauri" into "TAURİ".
        const badge =
          typeof p.badge === "string" ? (
            <span class="badge" lang="en">{p.badge}</span>
          ) : (
            <span class="badge">{p.badge[lang]}</span>
          );
        // A card with a second link (live site + repo) cannot be one big anchor.
        return p.repo && p.href ? (
          <div class:list={cls} style={delay}>
            {badge}
            <h3>{p.name}</h3>
            <p>{p.desc[lang]}</p>
            <span class="more">
              <a href={p.href} target="_blank" rel="noopener noreferrer">{p.linkLabel ?? t.github}</a>
              <a href={p.repo} target="_blank" rel="noopener noreferrer">{t.github}</a>
            </span>
          </div>
        ) : !p.href ? (
          <div class:list={cls} style={delay}>
            {badge}
            <h3>{p.name}</h3>
            <p>{p.desc[lang]}</p>
          </div>
        ) : (
          <a class:list={cls} style={delay} href={p.href} target="_blank" rel="noopener noreferrer">
            {badge}
            <h3>{p.name}</h3>
            <p>{p.desc[lang]}</p>
            <span class="more">{p.linkLabel ?? t.github}</span>
          </a>
        );
      })}
    </div>
  </div>
</section>
